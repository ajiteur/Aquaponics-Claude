          },
          "unit": "pH",
          "effect": "nitrification_inhibited",
          "severity": "warning"
        },
        {
          "label": "dieoff_risk_begins",
          "threshold": {
            "operator": "<",
            "value": 5.5
          },
          "unit": "pH",
          "effect": "nitrifier_dieoff_risk",
          "severity": "critical"
        }
      ],
      "context_tags": [
        "aquaponics_specific",
        "nitrifiers",
        "warning_ladder"
      ],
      "notes": [
        "Nitrification declines around pH 6.0 and die-off risk begins below about pH 5.5."
      ]
